PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oficinatech
DB_USER=oficinatech_app
DB_PASSWORD=
# Use true para bancos em nuvem que exigem TLS (ex.: TiDB Cloud)
DB_SSL=false
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Opcionais
# Máximo de conexões do pool (padrão 10; 3 na Vercel)
DB_POOL_LIMIT=
# Duração da sessão em minutos (padrão 480)
SESSION_MINUTES=
